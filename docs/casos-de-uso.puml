@startuml
left to right direction
actor Cliente
actor Agente
rectangle "Sistema de Aluguel de Carros" {
  usecase "Cadastrar-se / Login" as UC1
  usecase "Gerenciar clientes (CRUD)" as UC2
  usecase "Cadastrar automóvel" as UC3
  usecase "Criar pedido de aluguel" as UC4
  usecase "Consultar status do pedido" as UC5
  usecase "Cancelar pedido" as UC6
  usecase "Avaliar pedido (aprovar/rejeitar)" as UC7
}
Cliente --> UC1
Cliente --> UC2
Cliente --> UC4
Cliente --> UC5
Cliente --> UC6
Agente --> UC1
Agente --> UC3
Agente --> UC5
Agente --> UC7
@enduml